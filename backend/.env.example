# EngineerGPT backend configuration. Copy to `.env` and fill in real values.
# Secrets must never be committed. Everything here has a safe local default
# except where noted.

# --- Core ---
ENVIRONMENT=development
# Generate a strong random value in production (e.g. `openssl rand -hex 32`).
SECRET_KEY=dev-insecure-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database ---
# Local dev uses a SQLite file automatically (no config needed). For production,
# set DATABASE_URL (managed Postgres). postgres:// URLs are normalized to psycopg.
# DATABASE_URL=postgresql://user:pass@host:5432/engineergpt
# Enable native pgvector only after running `CREATE EXTENSION vector`.
USE_PGVECTOR=false

# --- AI provider ---
# Keep `mock` for deterministic, credential-free runs. Switch to openai/azure
# and supply keys to wire real AI.
AI_PROVIDER=mock
# OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=

# --- Seed admin (created idempotently on startup when password is set) ---
ADMIN_EMAIL=admin@engineergpt.local
# ADMIN_PASSWORD=change-me-strong
ADMIN_FULL_NAME=EngineerGPT Admin

# --- CORS --- (comma-separated; must include your deployed frontend origin)
CORS_ORIGINS=["http://localhost:3000"]

# --- Public app / SaaS ---
# Public URL of the frontend; used for Stripe redirect URLs.
FRONTEND_URL=http://localhost:3000
# Set to false to lock the instance to invite-only (disables /auth/register).
ALLOW_PUBLIC_SIGNUP=true

# --- Billing (Stripe) --- optional; leave blank to run in free-only mode.
# When STRIPE_SECRET_KEY is set, paid plans become purchasable and the webhook
# endpoint (POST /api/v1/billing/webhook) activates subscriptions.
# STRIPE_SECRET_KEY=sk_live_or_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_PRICE_PRO=price_xxx     # Stripe Price ID for the Pro plan
# STRIPE_PRICE_TEAM=price_xxx    # Stripe Price ID for the Team plan
