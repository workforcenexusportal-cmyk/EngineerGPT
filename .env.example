# ---------------------------------------------------------------------------
# EngineerGPT — root environment template
# Copy to .env and adjust. NEVER commit a filled-in .env.
# ---------------------------------------------------------------------------

# --- Core ---
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database (pgvector-enabled Postgres) ---
POSTGRES_USER=engineergpt
POSTGRES_PASSWORD=engineergpt
POSTGRES_DB=engineergpt
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://cache:6379/0

# --- AI provider ---
# Leave OPENAI_API_KEY empty to run in deterministic mock mode (no external calls).
AI_PROVIDER=openai            # openai | azure | mock
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Azure OpenAI (only if AI_PROVIDER=azure) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-06-01

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=50
STORAGE_DIR=./storage

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
